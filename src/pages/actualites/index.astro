---
import MainLayout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import { formatDateFR } from "../../utils/date";

import {type CollectionEntry, getCollection} from "astro:content";
const posts: CollectionEntry<"actualites">[] = await getCollection("actualites");
---

<MainLayout title="Actualités – CAPO Judo Limoges">
    <Hero
        title="Actualités du club"
        subtitle="Suivez la vie du CAPO Judo Limoges"
        small={true}
    />
    <Section>
        <div class="actualites-header">
            <h2>Les dernières informations</h2>
            <p>
                Retrouvez ici les événements, résultats et moments forts du club.
            </p>
        </div>

<!--<pre>{JSON.stringify(posts, null, 2)}</pre>-->

        {posts.length === 0 ? (
            <div class="grid-2">
                <Card>
                    <div class="card-content">
                        <h3>Rapport de l'assemblée générale 2026</h3>
                        <p>Assemblée Générale de la section JUDO du CAPO, le Vendredi 19 juin 2026</p>
                    </div>
                    <a href="/pdf/rapport-ag-2026.pdf" target="_blank" rel="noopener" class="actualites-link">
                        Rapport de l'assemblée générale 2026
                    </a>
                    <div class="card-footer">
                        <small class="date">
                            2026-06-19
                        </small>
                    </div>
                </Card>
                <Card>
                    <div class="card-content">
                        <h3>Challenge club 2026/2027</h3>
                        <p>Challenge du club pour 2026/2027</p>
                        <br>
                    </div>
                    <a href="/pdf/challenge-club-2026-2027.pdf" target="_blank" rel="noopener" class="actualites-link">
                        Challenge club 2026/2027
                    </a>
                    <div class="card-footer">
                        <small class="date">
                            2026-06-19
                        </small>
                    </div>
                </Card>
                <!--<Card>-->
                <!--    <div class="card-content">-->
                <!--        <h3>Historique - Rapport de l'assemblée générale</h3>-->
                <!--        <p>Historique des assemblées générales de la section JUDO du CAPO</p>-->
                <!--    </div>-->
                <!--    <a href="/pdf/rapport-ag-2026.pdf" target="_blank" rel="noopener">-->
                <!--        Rapport de l'assemblée générale 2024-->
                <!--    </a>-->
                <!--    <a href="/pdf/rapport-ag-2026.pdf" target="_blank" rel="noopener">-->
                <!--        Rapport de l'assemblée générale 2023-->
                <!--    </a>-->
                <!--    <div class="card-footer">-->
                <!--        <small class="date">-->
                <!--            2026-06-19-->
                <!--        </small>-->
                <!--    </div>-->
                <!--</Card>-->
            </div>
        ) : (
            <div class="grid-2">
                {posts.map(post => (
                    <Card>
                        <div class="card-content">
                            <h3>{post.data.title}</h3>
                            <p>{post.data.excerpt}</p>
                        </div>
                        <div class="card-footer">
                            <small class="date">
                                {formatDateFR(post.data.date)}
                            </small>
                            <!--<a href={`/actualites/${post.slug}`} class="btn-primary">-->
                            <!--    Lire l'article-->
                            <!--</a>-->
                        </div>
                    </Card>
                ))}
            </div>
        )}
    </Section>
</MainLayout>