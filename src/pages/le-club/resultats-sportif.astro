---
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import MainLayout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
---

<MainLayout title="Résultats sportifs – CAPO Judo Limoges">
    <Hero
        title="Résultats sportifs"
        subtitle="Les performances des judokas du CAPO Judo Limoges."
        small={true}
    />
    <Section>
        <div class="grid-cards">
            <Card variant="result">
                <h3>Tournoi des Arts et du Feu Panazol - Benjamins</h3>
                <strong>1er - Mohamed ALI</strong>
                <small>Juin 2026</small>
                <img
                    src="/images/resultats/benjamin-panazol-21-06-2026.jpg"
                    alt="Tournoi des Arts et du Feu Panazol – Mohamed ALI"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Tournoi des Arts et du Feu Panazol - Micro-poussins</h3>
                <strong>1er - Maria</strong>
                <small>Juin 2026</small>
                <img
                    src="/images/resultats/micro-poussins-panazol-21-06-2026.jpg"
                    alt="Tournoi des Arts et du Feu Panazol - Maria"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Tournoi des Arts et du Feu Panazol - Benjamins</h3>
                <strong>2ème - Maelle</strong>
                <small>Juin 2026</small>
                <img
                    src="/images/resultats/benjamin-f-panazol-21-06-2026.jpg"
                    alt="Tournoi des Arts et du Feu Panazol - Maelle"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Coupe de Printemps St Junien</h3>
                <br>
                <strong>1er - Jules ROUSSEAU</strong>
                <small>Mai 2026</small>
                <img
                    src="/images/resultats/resultat_saint_junien_05_2026.jpg"
                    alt="Coupe de Printemps St Junien – Jules ROUSSEAU"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Tournoi Cœur de Lion - JC Chalus</h3>
                <strong>1er - Mohamed ALI</strong>
                <small>Mai 2026</small>
                <img
                    src="/images/resultats/tournoi-coeur-de-lion-chalus.jpg"
                    alt="Tournoi Cœur de Lion – JC Chalus – Mohamed ALI"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Challenge Georges Pfeifer Saint-Léonard</h3>
                <strong>3ème - Maelle BESSON LAHAYE</strong>
                <small>Avril 2026</small>
                <img
                    src="/images/resultats/resultat_st_leonard_04_04_2026.jpg"
                    alt="Challenge Georges Pfeifer Saint-Léonard – Maelle BESSON LAHAYE"
                    class="result-img"
                />
            </Card>
            <Card variant="result">
                <h3>Challenge Georges Pfeifer Saint-Léonard - Poussin</h3>
                <strong>2ème – Jules ROUSSEAU</strong>
                <small>Avril 2026</small>
                <img
                    src="/images/resultats/tournoi-st-leonard-poussin.jpg"
                    alt="Challenge Georges Pfeifer Saint-Léonard – Jules Rousseau"
                    class="result-img"
                />
            </Card>
        </div>
    </Section>
</MainLayout>